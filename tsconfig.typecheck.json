{
  // O `pnpm typecheck` do repo — cobre o runtime Node/Next e os testes desse runtime.
  // Supabase Edge Functions usam Deno e são compiladas/validadas pelo próprio
  // deploy de Edge Functions; misturar os dois ambientes gera falsos erros de tipos.
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "scripts/**",
    "supabase/functions/**"
  ]
}
