# Worker 24/7 do agent-engine (fusão Vendaval) + operações de prospecção.
# Roda TS direto via tsx (sem build): os workers são I/O-bound e o cold start não importa.
FROM node:22-alpine

WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/melgarafael/DeskcommCRM" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="DeskcommCRM worker"

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Healthz continua servido pelo agent-worker em 8787.
EXPOSE 8787

# Os dois processos são parte da mesma unidade operacional. Se qualquer um cair,
# o container encerra e o Render reinicia a unidade inteira, evitando falha silenciosa.
CMD ["sh", "-c", "pnpm exec tsx workers/agent-worker/main.ts & AGENT_PID=$!; pnpm exec tsx workers/prospecting-ops/main.ts & PROSPECT_PID=$!; trap 'kill -TERM $AGENT_PID $PROSPECT_PID 2>/dev/null || true' TERM INT; wait -n $AGENT_PID $PROSPECT_PID; STATUS=$?; kill -TERM $AGENT_PID $PROSPECT_PID 2>/dev/null || true; wait $AGENT_PID $PROSPECT_PID 2>/dev/null || true; exit $STATUS"]
